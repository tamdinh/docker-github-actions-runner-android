# ==============================================================================
# GitHub Actions Self-Hosted Runner Environment Configuration
# ==============================================================================

# Target GitHub Repository URL (or Organization URL for org-level runners)
# Examples:
#   Repository: https://github.com/my-org/my-expo-app
#   Organization: https://github.com/my-org
REPO_URL=https://github.com/owner/repository

# Runner Authentication
# Option 1: Temporary runner registration token (from Settings > Actions > Runners > New runner)
RUNNER_TOKEN=your_github_runner_registration_token

# Option 2: GitHub Personal Access Token (PAT) with repo/admin:org scope.
# Strongly recommended because preflight entrypoint can automatically check runner
# validity and re-register without container crash loops if credentials become stale.
# ACCESS_TOKEN=ghp_your_github_personal_access_token

# Runner Name and Identification
RUNNER_NAME=expo-android-runner

# Runner Labels (comma-separated, used in workflow `runs-on`)
RUNNER_LABELS=self-hosted,linux,x64,expo,android,web,vps

# Runner Work Directory
RUNNER_WORKDIR=/runner/_work

# Persistence and Stability Settings
CONFIGURED_ACTIONS_RUNNER_FILES_DIR=/runner-data
DISABLE_AUTOMATIC_DEREGISTRATION=true

# Optional: EAS / Expo Credentials (if needed by your EAS Local Build workflows)
# EXPO_TOKEN=your_expo_token
